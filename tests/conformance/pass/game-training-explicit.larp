archetype Stats {
    highkey mf power;
    highkey mf visualBonus;

    init(mf power, mf visualBonus) {
        self.power = power;
        self.visualBonus = visualBonus;
    }
}

main_character {
    Stats stats = new Stats(10, 0);

    // Begin trial.
    Stats trial = new Stats(stats.power, stats.visualBonus);
    trial.power += 5;
    trial.visualBonus = 500;
    mf projectedScore = trial.power * 2;
    if (projectedScore >= 30) {
        stats.power = trial.power;
    }
    // End trial.

    yap(stats.power);
    yap(stats.visualBonus);
}
